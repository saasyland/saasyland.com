{
  "name": "saasyland",
  "version": "2.0.0",
  "private": true,
  "description": "",
  "keywords": [
    "full-stack starter",
    "full-stack template",
    "saas boilerplate",
    "saas starter",
    "saas template"
  ],
  "homepage": "https://saasyland.com",
  "bugs": {
    "url": "https://github.com/pjborowiecki/saasyland.com/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Piotr Borowiecki",
    "email": "hello@pjborowiecki.com",
    "url": "https://pjborowiecki.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pjborowiecki/saasyland.com.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun run --bun next build",
    "check": "bun run check:i18n && vp check && bun scripts/check-summary.ts",
    "check:fix": "bun run check:i18n && vp check --fix && bun scripts/check-summary.ts",
    "check:i18n": "bun scripts/check-i18n.ts",
    "check:pre-commit": "bun run check:i18n && vp staged",
    "clean": "rm -rf .next .source tsconfig.tsbuildinfo coverage playwright-report test-results blob-report .bun-cache",
    "clean:deep": "bun run clean && rm -rf node_modules",
    "clean:hardcore": "bun run clean:deep && rm -rf bun.lock skills-lock.json",
    "db:generate": "bun --env-file=.env.local run drizzle-kit generate --config=./src/platform/db/drizzle.config.ts",
    "db:introspect": "bun --env-file=.env.local run drizzle-kit introspect --config=./src/platform/db/drizzle.config.ts",
    "db:migrate": "bun --env-file=.env.local run drizzle-kit migrate --config=./src/platform/db/drizzle.config.ts",
    "db:migrate:preview": "bun --env-file=.env.preview.local run drizzle-kit migrate --config=./src/platform/db/drizzle.config.ts",
    "db:migrate:production": "bun --env-file=.env.production.local run drizzle-kit migrate --config=./src/platform/db/drizzle.config.ts",
    "db:push": "bun --env-file=.env.local run drizzle-kit push --config=./src/platform/db/drizzle.config.ts",
    "db:studio": "bun --env-file=.env.local run drizzle-kit studio --config=./src/platform/db/drizzle.config.ts",
    "db:studio:preview": "bun --env-file=.env.preview.local run drizzle-kit studio --config=./src/platform/db/drizzle.config.ts",
    "db:studio:production": "bun --env-file=.env.production.local run drizzle-kit studio --config=./src/platform/db/drizzle.config.ts",
    "deploy:preview": "bunx vercel deploy -y",
    "deploy:prod": "bunx vercel deploy --prod -y",
    "dev": "bun run --bun next dev",
    "env:pull:development": "bunx vercel env pull .env.local --environment=development",
    "env:pull:preview": "bunx vercel env pull .env.preview.local --environment=preview",
    "env:pull:production": "bunx vercel env pull .env.production.local --environment=production",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "vp config --no-agent",
    "skills:sync": "bun scripts/sync-skills.ts",
    "start": "bun run --bun next start",
    "test": "vp test run",
    "test:all": "bun run test && bun run test:e2e:smoke",
    "test:changed": "vp test run --changed",
    "test:component": "vp test run --project component",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:e2e:pr": "playwright test e2e/specs --project=chromium",
    "test:e2e:smoke": "playwright test e2e/specs/smoke.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vp test run --project integration",
    "test:unit": "vp test run --project node",
    "test:watch": "vp test",
    "typegen": "bun run --bun next typegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@internationalized/date": "^3.12.3",
    "@neondatabase/serverless": "^1.1.0",
    "@next-safe-action/adapter-better-auth": "^0.1.6",
    "@react-email/editor": "^1.7.0",
    "@react-email/ui": "^6.9.1",
    "@shadcn/react": "^0.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^9.0.1",
    "@types/mdx": "^2.0.14",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.0",
    "@vercel/speed-insights": "^2.0.0",
    "@wrksz/themes": "^1.1.0",
    "better-auth": "^1.6.26",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.29",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.14.2",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.14.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.30.0",
    "motion": "^13.1.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "next-safe-action": "^8.6.0",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "react-email": "^6.9.1",
    "react-hook-form": "^7.84.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "vercel": "^58.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/playwright": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@voidzero-dev/vite-plus-core": "^0.2.8",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver",
    "next"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "next"
  ]
}
