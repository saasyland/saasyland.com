# Copy to .env.local and fill in real values (never commit .env.local):
#   cp .env.example .env.local
#
# Preview / production: set the same variable names in Vercel → Project → Settings → Environment Variables.
# DB schema: `postinstall` migrates on Vercel (prod/preview env) or locally via `bun run db:migrate` when `.env.local` exists. `bun run build` is Next only. Prototype-only: `db:push`.
# With the Neon integration, DATABASE_URL is often injected for you; still set AUTH_SECRET and NEXT_PUBLIC_APP_URL per environment.
#
# Refresh local env from Vercel (optional):
#   vercel env pull .env.local

# App URL — use http://localhost:3000 locally; production / preview URLs in Vercel.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Pooled connection — use for Next.js runtime (Vercel serverless, local dev). From Neon “Connect” with pooler / ?pgbouncer.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) — optional; recommended for drizzle-kit migrate / DDL. From Neon “Connect” without pooler.
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — must match length expected in src/platform/env (e.g. openssl rand -base64 96)
AUTH_SECRET="your-secret-key"

# GitHub OAuth App — create at https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth API — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Upstash Redis — Vercel → Marketplace → Upstash (injected by `vercel env pull`).
KV_REST_API_URL="https://your-redis.upstash.io"
KV_REST_API_TOKEN="your-upstash-rest-token"

# Resend — API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"

# Verified sender in Resend (use onboarding@resend.dev for local testing).
RESENND_EMAIL_FROM="onboarding@resend.dev"
