  "keywords": [
    "saas starter",
    "saas template",
    "saas boilerplate",
    "full-stack template",
    "full-stack starter"
  ],
  "scripts": {
    "build": "bun run --bun next build",
    "dev": "bun run --bun next dev",
    "start": "bun run --bun next start",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "clean:deep": "bun run clean && rm -rf node_modules",
    "clean:hardcore": "bun run clean:deep && rm -rf bun.lock skills-lock.json",
    "check": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome check",
    "prepare": "husky",
    "typegen": "bun run --bun next typegen",
    "postinstall": "bun run --bun next typegen",
    "deploy:prod": "vercel deploy --prod -y",
    "deploy:preview": "vercel deploy -y"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "better-auth": "^1.5.6",
