{
  "name": "saasyland",
  "version": "2.0.0",
  "private": true,
  "description": "",
  "keywords": [
    "full-stack starter",
    "full-stack template",
    "saas boilerplate",
    "saas starter",
    "saas template"
  ],
  "homepage": "https://saasyland.com",
  "bugs": {
    "url": "https://github.com/pjborowiecki/saasyland.com/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Piotr Borowiecki",
    "email": "hello@pjborowiecki.com",
    "url": "https://pjborowiecki.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pjborowiecki/saasyland.com.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun run --bun next build",
    "dev": "bun run --bun next dev",
    "start": "bun run --bun next start",
    "clean": "rm -rf .next .source tsconfig.tsbuildinfo coverage playwright-report test-results blob-report .bun-cache",
    "clean:deep": "bun run clean && rm -rf node_modules",
    "clean:hardcore": "bun run clean:deep && rm -rf bun.lock skills-lock.json",
    "db:generate": "bun --env-file=.env.local run drizzle-kit generate --config=./src/platform/db/drizzle.config.ts",
    "db:migrate": "bun --env-file=.env.local run drizzle-kit migrate --config=./src/platform/db/drizzle.config.ts",
    "db:push": "bun --env-file=.env.local run drizzle-kit push --config=./src/platform/db/drizzle.config.ts",
    "db:introspect": "bun --env-file=.env.local run drizzle-kit introspect --config=./src/platform/db/drizzle.config.ts",
    "db:studio": "bun --env-file=.env.local run drizzle-kit studio --config=./src/platform/db/drizzle.config.ts",
    "check": "bun run check:i18n && vp check",
    "check:fix": "bun run check:i18n && vp check --fix",
    "check:i18n": "bun scripts/check-i18n.ts",
    "check:pre-commit": "bun run check:i18n && vp staged && bun run test && bun run build",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:unit": "vp test run --project node",
    "test:integration": "vp test run --project integration",
    "test:component": "vp test run --project component",
    "test:coverage": "vp test run --coverage",
    "test:changed": "vp test run --changed",
    "test:all": "bun run test && bun run test:e2e:smoke",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:e2e:smoke": "playwright test e2e/specs/smoke.spec.ts --project=chromium",
    "test:e2e:pr": "playwright test e2e/specs --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "vp config --no-agent",
    "typegen": "bun run --bun next typegen",
    "postinstall": "bun scripts/postinstall.ts",
    "deploy:prod": "bunx vercel deploy --prod -y",
    "deploy:preview": "bunx vercel deploy -y"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@internationalized/date": "^3.12.2",
    "@neondatabase/serverless": "^1.1.0",
    "@react-email/editor": "^1.6.10",
    "@react-email/ui": "^6.9.0",
    "@shadcn/react": "^0.2.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "@types/mdx": "^2.0.14",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "@vercel/speed-insights": "^2.0.0",
    "@wrksz/themes": "^1.0.0",
    "better-auth": "^1.6.23",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.29",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.11.5",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.11.5",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.25.0",
    "next": "16.3.0-canary.90",
    "next-intl": "^4.13.2",
    "next-safe-action": "^8.6.0",
    "nuqs": "^2.9.1",
    "react": "19.2.7",
    "react-aria-components": "^1.19.0",
    "react-dom": "19.2.7",
    "react-email": "^6.9.0",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.0",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "vercel": "^56.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "@voidzero-dev/vite-plus-core": "^0.2.5",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.5"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.52",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver",
    "next"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "next"
  ]
}
