{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!.source",
      "!dist",
      "!build",
      "!.agents",
      "!src/types/env.d.ts",
      "!src/integrations/next-intl/messages/*.d.json.ts",
      "!src/integrations/drizzle-orm/migrations"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react", "react/**", "next", "next/**"],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ["~/src/environment", "~/src/environment/**"],
              ":BLANK_LINE:",
              ["~/src/constants", "~/src/constants/**"],
              ":BLANK_LINE:",
              ["~/src/providers/**"],
              ":BLANK_LINE:",
              ["~/src/integrations/**"],
              ":BLANK_LINE:",
              ["~/src/lib/**"],
              ":BLANK_LINE:",
              ["~/src/components", "~/src/components/**"],
              ":BLANK_LINE:",
              ["~/src/styles", "~/src/styles/**"],
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noJsxLiterals": {
          "level": "error",
          "options": {
            "allowedStrings": ["/", "-"]
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next/link": "Import from `~/src/integrations/next-intl/i18n.navigation` instead",
              "next/navigation": {
                "importNames": ["redirect", "permanentRedirect", "useRouter", "usePathname"],
                "message": "Import from `~/src/integrations/next-intl/i18n.navigation` instead"
              }
            }
          }
        }
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "attributes": ["classList", "className"],
            "functions": ["clsx", "cn", "cva", "tw"]
          }
        },
        "useInlineScriptId": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/components/shadcn/form.tsx", "**/components/shadcn/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
