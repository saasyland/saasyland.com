{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["es2015"],
    "types": ["node", "react", "web"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "paths": {
      "~/*": ["../*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "remotion.config.ts"]
}
