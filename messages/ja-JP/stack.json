{
  "architecture": {
    "label": "アーキテクチャ",
    "options": {
      "monolith": "モノリス",
      "split": "分割 API",
      "microservices": "マイクロサービス"
    }
  },
  "api": {
    "label": "API",
    "options": {
      "hono": "Hono",
      "elysia": "Elysia"
    },
    "note": "独自のAPIを持つのは分割 APIとマイクロサービスだけです。ElysiaはBun向けですが、CloudflareではBunが動作しません。"
  },
  "auth": {
    "label": "認証",
    "options": {
      "better-auth": "Better Auth",
      "none": "なし"
    }
  },
  "billing": {
    "label": "請求",
    "options": {
      "stripe": "Stripe",
      "polar": "Polar",
      "none": "なし"
    }
  },
  "content": {
    "label": "コンテンツ",
    "options": {
      "mdx": "MDXブログとドキュメント",
      "none": "なし"
    }
  },
  "database": {
    "label": "データベース",
    "options": {
      "postgres": "Postgres",
      "sqlite": "SQLite"
    },
    "note": "SQLiteには永続ファイルシステムまたはD1バインディングが必要ですが、Vercelはどちらも提供していません。"
  },
  "deployment": {
    "label": "デプロイ",
    "options": {
      "vercel": "Vercel",
      "cloudflare": "Cloudflare",
      "self": "自己ホスト型"
    }
  },
  "runtime": {
    "label": "ランタイム",
    "options": {
      "node": "Node",
      "bun": "Bun",
      "deno": "Deno"
    },
    "note": "CloudflareではBunやDenoではなくWorkersが動作します。BunはVercelまたはセルフホスティングで、Denoはセルフホスティングで動作します。"
  },
  "email": {
    "label": "メールアドレス",
    "options": {
      "resend": "Resend",
      "plunk": "Plunk",
      "none": "なし"
    }
  },
  "library": {
    "label": "UIライブラリ",
    "options": {
      "react": "React",
      "angular": "Angular",
      "vue": "Vue",
      "svelte": "Svelte",
      "solid": "Solid"
    }
  },
  "framework": {
    "label": "フレームワーク",
    "options": {
      "next": "Next.js",
      "tanstack": "TanStack Start",
      "react-router": "React Router",
      "analog": "Analog",
      "angular-ssr": "Angular SSR",
      "nuxt": "Nuxt",
      "sveltekit": "SvelteKit",
      "solid-start": "SolidStart"
    },
    "note": "各フレームワークは、見出しのUIライブラリで動作します。選べるのは、選択したライブラリのフレームワークだけです。TanStack StartはReactとSolidの両方で動作します。"
  },
  "orm": {
    "label": "ORM",
    "options": {
      "drizzle": "Drizzle",
      "prisma": "Prisma"
    }
  },
  "provider": {
    "label": "プロバイダー",
    "options": {
      "neon": "Neon",
      "supabase": "Supabase",
      "self-postgres": "あなた自身の",
      "d1": "Cloudflare D1",
      "turso": "Turso",
      "file": "ローカルファイル"
    },
    "note": "Cloudflare D1、Turso、ローカルファイルはSQLite用、その他はPostgres用です。D1にはCloudflareが、ローカルファイルにはセルフホスティングが必要です。"
  },
  "tenancy": {
    "label": "テナント構成",
    "options": {
      "multi": "マルチテナント",
      "single": "シングルテナント"
    }
  },
  "extras": {
    "label": "機能",
    "options": {
      "commerce": "サンプル商品付きストア",
      "courses": "サブスクリプション型コース",
      "page-builder": "ビジュアルページビルダー",
      "post-editor": "ビジュアル投稿エディター"
    },
    "note": "ストアとサブスクリプション型コースには課金プロバイダーが必要です。ビジュアル投稿エディターにはMDXコンテンツが必要です。"
  }
}
