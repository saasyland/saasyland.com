{
  "name": "saasyland",
  "description": "",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://saasyland.com",
  "author": {
    "name": "Piotr Borowiecki",
    "email": "hello@pjborowiecki.com",
    "url": "https://pjborowiecki.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pjborowiecki/saasyland.com.git"
  },
  "bugs": {
    "url": "https://github.com/pjborowiecki/saasyland.com/issues"
  },
  "keywords": [
    "saas starter",
    "saas template",
    "saas boilerplate",
    "full-stack template",
    "full-stack starter"
  ],
  "scripts": {
    "build": "bun run --bun next build",
    "dev": "bun run --bun next dev",
    "start": "bun run --bun next start",
    "clean": "rm -rf .next tsconfig.tsbuildinfo coverage playwright-report test-results blob-report .biome-cache .bun-cache",
    "clean:deep": "bun run clean && rm -rf node_modules",
    "clean:hardcore": "bun run clean:deep && rm -rf bun.lock skills-lock.json",
    "db:generate": "bun --env-file=.env.local run drizzle-kit generate --config=./src/integrations/drizzle-orm/drizzle.config.ts",
    "db:migrate": "bun --env-file=.env.local run drizzle-kit migrate --config=./src/integrations/drizzle-orm/drizzle.config.ts",
    "db:push": "bun --env-file=.env.local run drizzle-kit push --config=./src/integrations/drizzle-orm/drizzle.config.ts",
    "db:introspect": "bun --env-file=.env.local run drizzle-kit introspect --config=./src/integrations/drizzle-orm/drizzle.config.ts",
    "db:studio": "bun --env-file=.env.local run drizzle-kit studio --config=./src/integrations/drizzle-orm/drizzle.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome check",
    "prepare": "husky",
    "typegen": "bun run --bun next typegen",
    "postinstall": "bun scripts/postinstall.ts",
    "deploy:prod": "bunx vercel deploy --prod -y",
    "deploy:preview": "bunx vercel deploy -y"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/functions": "^3.4.3",
    "better-auth": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.28",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "shadcn": "^4.1.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver",
    "next"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "next"
  ],
  "packageManager": "bun@1.3.9"
}
