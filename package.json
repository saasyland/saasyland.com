{
  "name": "saasyland",
  "version": "2.0.0",
  "private": true,
  "description": "",
  "keywords": [
    "full-stack starter",
    "full-stack template",
    "saas boilerplate",
    "saas starter",
    "saas template"
  ],
  "homepage": "https://saasyland.com",
  "bugs": {
    "url": "https://github.com/pjborowiecki/saasyland.com/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Piotr Borowiecki",
    "email": "hello@pjborowiecki.com",
    "url": "https://pjborowiecki.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pjborowiecki/saasyland.com.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun run build:preview",
    "check": "bun run check:i18n && vp check",
    "check:fix": "bun run check:i18n && vp check --fix",
    "check:i18n": "bun scripts/check-i18n.ts && bun scripts/check-message-formats.ts && bun scripts/check-content.ts",
    "check:pre-commit": "bun run check:i18n && vp staged",
    "clean": "rm -rf .source .tanstack .wrangler dist coverage playwright-report test-results blob-report *.tsbuildinfo",
    "clean:deep": "bun run clean && rm -rf node_modules",
    "clean:hardcore": "bun run clean:deep && rm -rf bun.lock skills-lock.json",
    "db:generate": "drizzle-kit generate --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:introspect:development": "bun --env-file=.env.development run drizzle-kit introspect --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:migrate:development": "wrangler d1 migrations apply DB --env development --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "db:studio:development": "bun --env-file=.env.development run drizzle-kit studio --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:studio:preview": "bun --env-file=.env.preview run drizzle-kit studio --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:studio:production": "bun --env-file=.env.production run drizzle-kit studio --config src/integrations/drizzle-orm/drizzle.config.ts",
    "deploy:preview": "bun scripts/verify-bindings.ts preview && bun run build:preview && wrangler deploy --env preview --secrets-file .env.preview",
    "deploy:production": "bun scripts/verify-bindings.ts production && bun run build:production && wrangler deploy --env production --secrets-file .env.production",
    "dev": "bun run content && CLOUDFLARE_ENV=development vp dev",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "vp config --no-agent && bun run content",
    "start": "CLOUDFLARE_ENV=preview vp preview --host 127.0.0.1 --port 3000",
    "test": "vp test run",
    "test:all": "bun run test && bun run test:e2e:smoke",
    "test:changed": "vp test run --changed",
    "test:component": "vp test run --project component",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:e2e:pr": "playwright test e2e/specs --project=chromium",
    "test:e2e:smoke": "playwright test e2e/specs/smoke.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vp test run --project integration",
    "test:unit": "vp test run --project node",
    "test:watch": "vp test",
    "typegen": "bun run cf-typegen && bun run content",
    "build:preview": "rm -rf dist && bun run content && CLOUDFLARE_ENV=preview vp build --mode preview && bun run scripts/verify-build.ts",
    "build:production": "rm -rf dist && bun run content && CLOUDFLARE_ENV=production vp build --mode production && bun run scripts/verify-build.ts",
    "content": "fumadocs-mdx ./src/integrations/fumadocs/fumadocs.config.ts .source",
    "cf-typegen": "wrangler types --env development src/types/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --env development --local",
    "db:introspect:preview": "bun --env-file=.env.preview run drizzle-kit introspect --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:introspect:production": "bun --env-file=.env.production run drizzle-kit introspect --config src/integrations/drizzle-orm/drizzle.config.ts",
    "skills:sync": "bun scripts/sync-skills.ts",
    "db:migrate:test": "wrangler d1 migrations apply DB --config src/platform/testing/wrangler.jsonc --local --persist-to .wrangler/test",
    "build:test": "rm -rf dist && bun run content && CLOUDFLARE_ENV= E2E=true vp build --mode test && bun run scripts/verify-build.ts",
    "start:test": "CLOUDFLARE_ENV= E2E=true sh -c 'set -a; . ./.env.test; set +a; exec vp preview --host 127.0.0.1 --port 3000 \"$@\"' --",
    "db:seed:test": "bun scripts/seed-test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@internationalized/date": "^3.12.4",
    "@polar-sh/better-auth": "^1.8.4",
    "@polar-sh/sdk": "^0.49.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.50",
    "@tanstack/react-table": "^9.2.4",
    "@wrksz/themes": "^1.2.0",
    "better-auth": "^1.7.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.15.8",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.15.8",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "react": "19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.3.0",
    "react-email": "^6.9.5",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.10.1",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "use-intl": "^4.14.2",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@voidzero-dev/vite-plus-core": "^0.3.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "jsonc-parser": "^3.3.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.1",
    "wrangler": "^4.130.0"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
