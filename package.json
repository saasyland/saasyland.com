{
  "name": "saasyland",
  "version": "2.0.0",
  "private": true,
  "description": "",
  "keywords": [
    "full-stack starter",
    "full-stack template",
    "saas boilerplate",
    "saas starter",
    "saas template"
  ],
  "homepage": "https://saasyland.com",
  "bugs": {
    "url": "https://github.com/saasyland/saasyland.com/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Piotr Borowiecki",
    "email": "hello@pjborowiecki.com",
    "url": "https://pjborowiecki.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saasyland/saasyland.com.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun run build:preview",
    "check": "bun run generate:cn && bun run check:i18n && vp check",
    "check:fix": "bun run generate:cn && bun run check:i18n && vp check --fix",
    "check:i18n": "bun scripts/check-i18n.ts && bun scripts/check-message-formats.ts && bun scripts/check-content.ts",
    "check:pre-commit": "bun run generate:cn && bun run check:i18n && vp staged",
    "clean": "rm -rf .source .tanstack .wrangler dist coverage playwright-report test-results blob-report *.tsbuildinfo",
    "clean:deep": "bun run clean && rm -rf node_modules",
    "clean:hardcore": "bun run clean:deep && rm -rf bun.lock skills-lock.json",
    "db:generate": "drizzle-kit generate --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:introspect:development": "bun --env-file=.env.development run drizzle-kit introspect --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:migrate:development": "wrangler d1 migrations apply DB --env development --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "db:studio:development": "bun --env-file=.env.development run drizzle-kit studio --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:studio:preview": "bun --env-file=.env.preview run drizzle-kit studio --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:studio:production": "bun --env-file=.env.production run drizzle-kit studio --config src/integrations/drizzle-orm/drizzle.config.ts",
    "deploy:preview": "bun scripts/verify-bindings.ts preview && bun run build:preview && wrangler deploy --secrets-file .env.preview",
    "deploy:production": "bun scripts/verify-bindings.ts production && bun run build:production && wrangler deploy --secrets-file .env.production",
    "dev": "bun run generate:cn && bun run content && CLOUDFLARE_ENV=development vp dev",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "vp config --no-agent && bun run generate:cn && bun run content",
    "start": "vp preview --host 127.0.0.1 --port 3000",
    "test": "vp test run",
    "test:all": "bun run test && bun run test:e2e:smoke",
    "test:changed": "vp test run --changed",
    "test:component": "vp test run --project component",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:e2e:pr": "playwright test e2e/specs --project=chromium",
    "test:e2e:smoke": "playwright test e2e/specs/smoke.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vp test run --project integration",
    "test:unit": "vp test run --project node",
    "test:watch": "vp test watch",
    "typegen": "bun run cf-typegen && bun run generate:cn && bun run content",
    "build:preview": "rm -rf dist && bun run generate:cn && bun run content && CLOUDFLARE_ENV=preview vp build --mode preview && bun run scripts/verify-build.ts && bun run scripts/optimize-prerendered-html.ts",
    "build:production": "rm -rf dist && bun run generate:cn && bun run content && CLOUDFLARE_ENV=production vp build --mode production && bun run scripts/verify-build.ts && bun run scripts/optimize-prerendered-html.ts",
    "content": "fumadocs-mdx ./src/integrations/fumadocs/fumadocs.config.ts .source",
    "cf-typegen": "wrangler types --env development src/types/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --env development --local",
    "db:introspect:preview": "bun --env-file=.env.preview run drizzle-kit introspect --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:introspect:production": "bun --env-file=.env.production run drizzle-kit introspect --config src/integrations/drizzle-orm/drizzle.config.ts",
    "skills:sync": "bun scripts/sync-skills.ts",
    "db:migrate:test": "wrangler d1 migrations apply DB --env test --local --persist-to .wrangler/test",
    "build:test": "rm -rf dist && bun run generate:cn && bun run content && CLOUDFLARE_ENV=test vp build --mode test && bun run scripts/verify-build.ts && bun run scripts/optimize-prerendered-html.ts",
    "start:test": "vp preview --mode test --host 127.0.0.1 --port 3000",
    "db:seed:test": "bun scripts/seed-test.ts",
    "generate:cn": "bun run --bun cn build --full --config src/lib/cn.config.ts --out .source/cn-tables.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fumadocs/base-ui": "^16.19.0",
    "@internationalized/date": "^3.12.4",
    "@polar-sh/better-auth": "^2.1.4",
    "@polar-sh/sdk": "^1.1.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@wrksz/themes": "^2.1.1",
    "better-auth": "^1.7.22",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.19.0",
    "fumadocs-mdx": "^15.6.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.11",
    "react-resizable-panels": "^4.21.0",
    "recharts": "3.10.1",
    "resend": "^6.38.0",
    "sonner": "^2.0.8",
    "use-intl": "^4.15.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@playwright/test": "^1.65.0",
    "@react-aria/live-announcer": "^3.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bun": "^1.4.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.0",
    "jsonc-parser": "^3.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp"
  ],
  "trustedDependencies": [
    "sharp"
  ]
}
