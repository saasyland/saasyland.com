{
  "architecture": {
    "label": "Architecture",
    "options": {
      "monolith": "Monolith",
      "split": "Split API",
      "microservices": "Microservices"
    }
  },
  "api": {
    "label": "API",
    "options": {
      "hono": "Hono",
      "elysia": "Elysia"
    },
    "note": "Only a split API or microservices run an API of their own. Elysia targets Bun, which Cloudflare does not run."
  },
  "auth": {
    "label": "Authentication",
    "options": {
      "better-auth": "Better Auth",
      "none": "None"
    }
  },
  "billing": {
    "label": "Billing",
    "options": {
      "stripe": "Stripe",
      "polar": "Polar",
      "none": "None"
    }
  },
  "content": {
    "label": "Content",
    "options": {
      "mdx": "MDX blog and docs",
      "none": "None"
    }
  },
  "database": {
    "label": "Database",
    "options": {
      "postgres": "Postgres",
      "sqlite": "SQLite"
    },
    "note": "SQLite needs a persistent filesystem or a D1 binding, and Vercel offers neither."
  },
  "deployment": {
    "label": "Deployment",
    "options": {
      "vercel": "Vercel",
      "cloudflare": "Cloudflare",
      "self": "Self-hosted"
    }
  },
  "runtime": {
    "label": "Runtime",
    "options": {
      "node": "Node",
      "bun": "Bun",
      "deno": "Deno"
    },
    "note": "Cloudflare runs Workers, not Bun or Deno. Bun runs on Vercel or on your own server, and Deno on your own server."
  },
  "email": {
    "label": "Email",
    "options": {
      "resend": "Resend",
      "plunk": "Plunk",
      "none": "None"
    }
  },
  "library": {
    "label": "UI library",
    "options": {
      "react": "React",
      "angular": "Angular",
      "vue": "Vue",
      "svelte": "Svelte",
      "solid": "Solid"
    }
  },
  "framework": {
    "label": "Framework",
    "options": {
      "next": "Next.js",
      "tanstack": "TanStack Start",
      "react-router": "React Router",
      "analog": "Analog",
      "angular-ssr": "Angular SSR",
      "nuxt": "Nuxt",
      "sveltekit": "SvelteKit",
      "solid-start": "SolidStart"
    },
    "note": "Each framework runs on the UI library it is listed under, so only your library’s frameworks can be picked. TanStack Start runs on React and on Solid."
  },
  "orm": {
    "label": "ORM",
    "options": {
      "drizzle": "Drizzle",
      "prisma": "Prisma"
    }
  },
  "provider": {
    "label": "Provider",
    "options": {
      "neon": "Neon",
      "supabase": "Supabase",
      "self-postgres": "Your own",
      "d1": "Cloudflare D1",
      "turso": "Turso",
      "file": "Local file"
    },
    "note": "Cloudflare D1, Turso and a local file serve SQLite, the others Postgres. D1 needs Cloudflare, and a local file needs your own server."
  },
  "tenancy": {
    "label": "Tenancy",
    "options": {
      "multi": "Multi-tenant",
      "single": "Single tenant"
    }
  },
  "extras": {
    "label": "Features",
    "options": {
      "commerce": "Store with sample products",
      "courses": "Subscription course",
      "page-builder": "Visual page builder",
      "post-editor": "Visual post editor"
    },
    "note": "A store and a subscription course need a billing provider, and the visual post editor needs MDX content."
  }
}
